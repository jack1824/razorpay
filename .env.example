# ── Database ────────────────────────────────────────────────────────────────
# TWO roles, deliberately. See THREAT_MODEL.md "The append-only control".
#   dwaar_owner : owns tables, runs migrations. The API NEVER connects as this.
#   dwaar_app   : NOT the table owner. SELECT+INSERT on decision_records only.
DATABASE_URL_MIGRATE=postgresql://dwaar_owner:owner_pw@postgres:5432/dwaar
DATABASE_URL_APP=postgresql://dwaar_app:app_pw@postgres:5432/dwaar

# Superuser. Used ONLY by the day-6 tamper demo, never by the application.
# The tamper must SUCCEED at the database so the chain verifier catches it.
DATABASE_URL_SUPERUSER=postgresql://postgres:postgres_pw@postgres:5432/dwaar

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pw
POSTGRES_DB=dwaar
DWAAR_OWNER_PASSWORD=owner_pw
DWAAR_APP_PASSWORD=app_pw

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Service ─────────────────────────────────────────────────────────────────
DWAAR_ENV=local
LOG_LEVEL=INFO
MAX_BODY_BYTES=65536
